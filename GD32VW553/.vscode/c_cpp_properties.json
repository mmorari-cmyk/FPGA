{
    "configurations": [
        {
            "name": "GD32VW553",
            "compilerPath": "${env:HOME}/.local/opt/nuclei/gcc/bin/riscv64-unknown-elf-gcc",
            "compilerArgs": ["-march=rv32imafdc_zba_zbb_zbc_zbs_xxldspn1x", "-mabi=ilp32d"],
            "includePath": [
                "${workspaceFolder}/**",
                "${env:HOME}/src/nuclei-sdk/NMSIS/Core/Include",
                "${env:HOME}/src/nuclei-sdk/SoC/gd32vw55x/Common/Include",
                "${env:HOME}/src/nuclei-sdk/SoC/gd32vw55x/Board/gd32vw553h_eval/Include"
            ],
            "defines": ["DOWNLOAD_MODE=DOWNLOAD_MODE_FLASHXIP", "CPU_SERIES=300"],
            "cStandard": "c11",
            "intelliSenseMode": "linux-gcc-x86"
        }
    ],
    "version": 4
}
